# --- 核心模型接入 (Core LLM) ---
# 建议统一使用 TA_ 前缀，同时也兼容 OPENAI_API_KEY / OPENAI_BASE_URL
TA_API_KEY=
TA_BASE_URL=https://api.openai.com/v1
TA_LLM_PROVIDER=openai

# 模型名配置 (默认已提供常用值)
TA_LLM_QUICK=gpt-4o-mini
TA_LLM_DEEP=gpt-4o

# --- 安全密钥 (Security) ---
# 用于加密用户 API Key 和签发 JWT，生产环境必须设置！
# 生成方式: openssl rand -base64 32
# 首次设置时，系统会自动将已有数据从默认密钥迁移到新密钥。
# TA_APP_SECRET_KEY=

# --- 进阶可选配置 (Advanced Optional) ---
# 提示词语言 (auto / zh / en)，默认 zh
# TA_LANGUAGE=zh

# 运行日志追踪 (1 开启 / 0 关闭)，默认 1
# TA_TRACE=1

# 辩论与风险讨论轮数 (1-5)，默认 1
# TA_MAX_DEBATE=1
# TA_MAX_RISK=1

# --- 定时任务 Token 护栏 (Scheduler Token Guard) ---
# 启动 scheduler 进程后是否允许自动执行定时分析，默认 1
# SCHEDULER_ENABLED=1
# 只做审计日志，不发起 LLM 分析、不写 last_run_date，默认 0
# SCHEDULER_DRY_RUN=0
# 是否允许盘中触发点，例如 14:30；默认 1，尊重用户主动创建的定时任务
# SCHEDULER_RUN_INTRADAY=1
# 单轮最多领取几个定时任务，默认 1
# SCHEDULER_MAX_TASKS_PER_TICK=1
# 可选：只允许这些触发点自动运行，例如 20:00,22:00；留空表示全部允许
# SCHEDULER_ALLOWED_TRIGGER_TIMES=

# --- VLM 截图识别 (Vision Language Model) ---
# 用于持仓截图识别，默认使用智谱 glm-4.6v-flash（免费）
# TA_VLM_API_KEY=你的智谱API Key
# TA_VLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# TA_VLM_MODEL=glm-4.6v-flash

# --- 邮件服务 (Email/SMTP) ---
# 仅在需要开启邮箱验证码登录时配置
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_USER=你的邮箱
# MAIL_PASS=你的授权码
# MAIL_FROM=发件人名称
# MAIL_SSL=1

# 兼容说明: 系统自动识别 TA_ 前缀变量。
# 若需修改默认行为，取消上述注释并填值即可。
